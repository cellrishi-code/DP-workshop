#include <bits/stdc++.h>
using namespace std;


int n ;
int rec(int level){ // ret -> number of
    // level -> stair i am at

 //base casee
    if(level == n){
    	return 1;
    }
int ans = 0 ;
  // iterating over the choice 
    for(step =1 ; step<= 3 ; step++){
    	if(step+level <= n ){  //cheaking line
    		int ways = rec(level+step);
    		ans = ans+ways;

    	}
    }
    return ans ;
}

