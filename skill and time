#include <bits/stdc++.h>
using namespace std;

int n ;
int t[1001];
int s[1001];
int x , k;
int taken[1001];


bool cheak(int level){
    int tiemtaken = 0 ;
    int itemtaken = 0;
    for(int =0 ; i<level;i++){
        if(taken[i]){
            timetaken += t[i];
            itemtaken += 1;
        }
    }
    timetaken += t[level];
    itemtaken++;

    if(timetaken<=x && itemtaken<=k){
        return 1;
    }else {
        return 0 ; 
    }
}

int rec(int level){



    if(level == n){
        return 0 ;     //mostly in min-max prblm.
    }


    //not taken choice 1:
    int ans = rec(level+1);

    //choice 2: taken
    if(cheak(level)){
        taken[level]= 1;
        int ans = max(ans ,s[level]+rec(level+1));
        taken[level]=0;
    }
}

void solve(){
    int n ; 
    cin>>n ;
    for(int i = 0 ; i<n; i++){
        cin>>t[i]>>s[i];
    }
    cin>>x>>k;
    cout<<rec(0)<<endl;


}

int main(){
    ios_base::sync_with_stdio(0);
    cin.tie(0); cout.tie(0);

    int t=1;
    // cin>>t;
    for(int i=0;i<t;i++){
        solve();
    }
}

